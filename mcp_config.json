{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"]
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "render": {
      "command": "npx",
      "args": ["-y", "mcp-render"],
      "env": {
        "RENDER_API_KEY": "${RENDER_API_KEY}"
      }
    },
    "backlog": {
      "command": "/home/rdogen/OpenClaw_Factory/projects/Hosteva/venv/bin/python",
      "args": ["/home/rdogen/OpenClaw_Factory/projects/Hosteva/mcp_servers/backlog_mcp.py"]
    }
  }
}
